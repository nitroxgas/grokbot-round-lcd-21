#pragma once
// Copy to include/secrets.h (gitignored). Placeholder only: keep every field
// empty here, never commit a real URL, broker or password.
//
// WiFi is NOT configured here. WiFiManager opens a portal on first boot and
// the WiFi password is stored in NVS.

// --- Outbound: touch -> HTTP webhook POST (Grok Bot) -----------------------
// Base URL without trailing slash, e.g. "https://host/grokbot". Empty = no POST.
#define WEBHOOK_BASE  ""
// Optional. When set it is sent as "Authorization: Bearer <token>".
#define WEBHOOK_TOKEN ""

// --- Inbound: one MQTT subscribe (Grok Bot -> screen) ----------------------
// If MQTT_HOST, MQTT_USER, MQTT_PASS or MQTT_TOPIC is empty the device does
// not connect (no anonymous broker).
#define MQTT_HOST  ""
#define MQTT_PORT  8883
// 1 = TLS (WiFiClientSecure), 0 = plain TCP (WiFiClient). No CA is embedded.
#define MQTT_TLS   1
#define MQTT_USER  ""
#define MQTT_PASS  ""
// The single topic this device subscribes to. Payload = one of the four JSON
// bodies in docs/mqtt-webhook.md, told apart by their fields.
#define MQTT_TOPIC ""
